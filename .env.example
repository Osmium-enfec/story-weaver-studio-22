# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# LOCAL LAN: leave DATABASE_URL and SPACES_* empty/unset so the app keeps
# using SQLite + `.data/` on disk (same as before).

# Supabase — publishable keys only (safe to expose; VITE_* ship to the browser).
# Currently unused: auth runs on local SQLite (src/lib/local-auth-db.ts).
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# OpenAI (GPT) — script planning, vision, image generation
OPENAI_API_KEY=""

# Replicate — image segmentation, Grounding-DINO detection
REPLICATE_API_KEY=""

# ElevenLabs — TTS narration + speech-to-text transcription
ELEVENLABS_API_KEY=""

# --- DigitalOcean prod only (see .env.production.example / deploy/README.md) ---
# DATABASE_URL=
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_REGION=nyc3
# SPACES_BUCKET=
# SPACES_KEY=
# SPACES_SECRET=
# EXPORT_BASE_URL=https://divstudio.enfeca.com
# Inside Docker, Playwright must hit the app on loopback (not the public HTTPS host):
# EXPORT_INTERNAL_BASE_URL=http://127.0.0.1:3000
# ADMIN_EMAILS=
# ADMIN_BOOTSTRAP_PASSWORD=
