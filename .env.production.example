# Production / Droplet only. Do NOT copy these into your Mac `.env` used by `npm run dev:lan`.
# Local keeps SQLite + `.data/` when DATABASE_URL and SPACES_* are unset.

PORT=3000
NODE_ENV=production

# Public origin for Playwright export-runner navigation.
# On Docker Droplets, also add: --add-host=divstudio.enfeca.com:<docker_bridge_gateway>
# so the hostname does not resolve to the host's 127.0.1.1 (ECONNREFUSED :443 in-container).
EXPORT_BASE_URL=https://divstudio.enfeca.com
# Optional: loopback for API-only fetches when the public host is unreachable in-container.
# Bumper MP4/MP3 must still be reachable at the origin Playwright uses (nginx or baked public/).
EXPORT_INTERNAL_BASE_URL=http://127.0.0.1:3000

# Phase 2 — Managed Postgres (private DO host works from Droplet only).
# The app applies migrations/001_init.sql on first query; set PG_AUTO_MIGRATE=0
# if you apply the schema yourself with psql.
# DATABASE_URL=postgresql://doadmin:...@private-....db.ondigitalocean.com:25061/divstudio?sslmode=require
# DO private CA — required or Node rejects the cert chain:
# PG_SSL_REJECT_UNAUTHORIZED=0

# Phase 2 — Spaces (endpoint may omit https://; app adds it).
# SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# SPACES_REGION=blr1
# SPACES_BUCKET=production-enfec-cloud
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_BASE_PATH=divstudio

ENFEC_DATA_ROOT=/var/lib/divstudio/data
ENFEC_SCRATCH_ROOT=/var/lib/divstudio/scratch
FFMPEG_PATH=/usr/bin/ffmpeg
PLAYWRIGHT_BROWSERS_PATH=/app/.playwright

ADMIN_EMAILS=divyanshu.singh@enfec.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-now

OPENAI_API_KEY=
REPLICATE_API_KEY=
ELEVENLABS_API_KEY=
